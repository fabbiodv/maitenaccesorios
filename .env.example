# Environment
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Application Secrets (Generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here
COOKIE_SECRET=your_cookie_secret_here

# CORS Configuration
ADMIN_CORS=https://admin.maitenaccesorios.com,http://localhost:7001
STORE_CORS=https://maitenaccesorios.com,https://www.maitenaccesorios.com,http://localhost:8000
AUTH_CORS=https://admin.maitenaccesorios.com,http://localhost:7001

# Application Port
PORT=9000

# Redis Configuration (Optional - for Cache and Events)
REDIS_URL=redis://localhost:6379

# Production Domain Configuration (Update for deployment)
# ADMIN_CORS=https://admin.yourdomain.com,http://admin.yourdomain.com,http://localhost:7001
# STORE_CORS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:8000
# AUTH_CORS=https://admin.yourdomain.com,http://admin.yourdomain.com